NODE_ENV=production
PORT=8080
# Public URL of the deployed FRONTEND (used in join links)
CLIENT_URL=https://your-frontend.up.railway.app
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
